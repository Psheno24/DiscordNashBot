# Скопируй в `.env` и заполни. Файл `.env` в git не коммитится.

# --- Discord (обязательно) ---
DISCORD_TOKEN=

# Каналы (необязательно; можно также задать в guild-конфиге бота)
DISCORD_WELCOME_CHANNEL_ID=
DISCORD_NEUROCONTROL_CHANNEL_ID=
DISCORD_ECONOMY_TERMINAL_CHANNEL_ID=
DISCORD_ECONOMY_FEED_CHANNEL_ID=

# --- Telegram (необязательно; без токена TG-часть не стартует) ---
TELEGRAM_BOT_TOKEN=
# Если задано — только эти Telegram user id (через запятую/пробел).
# Если пусто — бот принимает всех; привязка всё равно по коду из Discord.
TELEGRAM_ALLOWED_USER_IDS=

# --- Данные (необязательно) ---
# По умолчанию: ./data относительно WorkingDirectory процесса
# NASHBOT_DATA_DIR=/var/lib/discord-nash-bot
